<Project>
  <!-- Propiedades comunes a todos los proyectos del repositorio. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Versión pública (etiqueta de GitHub Releases: v{VersionPrefix}-{VersionSuffix}). El auto-actualizador la compara con la última publicada. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Purgine</Product>
    <Authors>xeccu (XCC Studios)</Authors>
    <Company>XCC Studios</Company>
    <PackageProjectUrl>https://xccstudios.es</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xeccu/Purgine-Launcher</RepositoryUrl>
    <Copyright>Copyright (c) 2026 xeccu (XCC Studios). All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>
</Project>
