<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación oficial para Windows x64: un único Purgine.exe autocontenido (no necesita tener .NET instalado).
  Ese mismo .exe es el instalador: build/release.ps1 lo copia como dist/Purgine-Setup-v<versión>.exe.
  Uso: dotnet publish src/Purgine/Purgine.csproj -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Las DLL nativas (WPF, WebView2Loader) van dentro del .exe y se extraen solas al primer arranque. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sin comprimir a propósito: comprimido pesa ~63 MB en vez de ~143 MB, pero cada arranque descomprime los
         ensamblados en memoria privada (+65 MB de RAM medidos). Purgine prioriza consumir poco al usarse. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
