<UserControl x:Class="Purgine.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Barra de navegación ===== -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <DockPanel LastChildFill="True">
                    <!-- Selector de tienda: el mismo navegador para las dos (no se duplican procesos) -->
                    <Border DockPanel.Dock="Left" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource IconToggle}" GroupName="StoreKind" FontFamily="Segoe UI Variable Text, Segoe UI"
                                         FontSize="12" Content="Steam" IsChecked="{Binding IsSteamStore, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource IconToggle}" GroupName="StoreKind" FontFamily="Segoe UI Variable Text, Segoe UI"
                                         FontSize="12" Content="Epic Games" IsChecked="{Binding IsEpicStore, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" Click="OnBack"
                                ToolTip="Atrás" IsEnabled="False" />
                        <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="OnForward"
                                ToolTip="Adelante" IsEnabled="False" Margin="4,0,0,0" />
                        <Button x:Name="ReloadButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="OnReload"
                                ToolTip="Recargar" Margin="4,0,0,0" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Click="OnHome"
                                ToolTip="Portada de la tienda" Margin="4,0,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8A7;" Click="OnOpenExternal"
                            ToolTip="Abrir esta página en tu navegador" Margin="8,0,0,0" />
                    <Border CornerRadius="6" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="AddressText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Text="store.steampowered.com" />
                        </DockPanel>
                    </Border>
                </DockPanel>
                <ProgressBar x:Name="LoadingBar" Style="{StaticResource SlimProgress}" Height="2" VerticalAlignment="Bottom"
                             Margin="-12,0,-12,-6" IsIndeterminate="True" Background="Transparent" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ===== Navegador (el WebView2 se crea al abrir la pestaña y se libera al salir) ===== -->
        <Grid Grid.Row="1" x:Name="Host" Background="{StaticResource BgBrush}">
            <StackPanel x:Name="StartingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource SlimProgress}" Width="180" IsIndeterminate="True" />
                <TextBlock Text="Abriendo la tienda de Steam…" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock x:Name="ErrorTitle" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorDetail" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="RuntimeButton" Style="{StaticResource PrimaryButton}" Content="Descargar WebView2"
                            Click="OnGetRuntime" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button Style="{StaticResource GhostButton}" Content="Reintentar" Click="OnRetry" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
