<Window x:Class="Purgine.Views.SetupWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Width="500" Title="Instalar Purgine">
    <Grid>
        <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource PlayButtonBrush}" />
        <StackPanel Margin="26,22,26,24">
            <!-- Marca -->
            <DockPanel>
                <Image Source="/Assets/logo-mark-light.png" Width="54" Height="54" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Purgine" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="12" />
                </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,18" />

            <!-- Instalar -->
            <StackPanel x:Name="InstallPanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="14"
                           Text="Launcher ligero para tus juegos de Steam, Epic Games e itch.io. Se instala solo para tu usuario, sin permisos de administrador, en:" />
                <Border Background="#14FFFFFF" CornerRadius="6" Padding="10,7" Margin="0,10,0,14">
                    <TextBlock x:Name="InstallPathText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <CheckBox x:Name="DesktopShortcutBox" IsChecked="True" Content="Crear acceso directo en el Escritorio" />
                <CheckBox x:Name="LaunchAfterBox" IsChecked="True" Content="Abrir Purgine al terminar" />
                <TextBlock x:Name="ExistingText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Ya hay una instalación de Purgine: se actualizará. Tus perfiles, cuentas, ajustes y juegos se conservan." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" Padding="18,9" Click="OnCancel" />
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Instalar" IsDefault="True" Padding="22,9" Click="OnInstall" />
                </StackPanel>
            </StackPanel>

            <!-- Desinstalar -->
            <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="14" Text="¿Desinstalar Purgine de este equipo?" />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"
                           Text="Se quitan el programa, sus accesos directos (también los de juegos del menú Inicio) y su entrada en Aplicaciones instaladas. Los juegos instalados no se tocan." />
                <CheckBox x:Name="DeleteDataBox">
                    <TextBlock TextWrapping="Wrap"
                               Text="Borrar también mis datos: perfiles, cuentas vinculadas, ajustes, etiquetas, tiempo jugado, notas y copias de partidas (los juegos de itch.io instalados se conservan)" />
                </CheckBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" Padding="18,9" Click="OnCancel" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Desinstalar" Padding="22,9" Click="OnUninstall" />
                </StackPanel>
            </StackPanel>

            <!-- Progreso -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap" />
                <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Height="4" Margin="0,14,0,4" />
            </StackPanel>

            <!-- Resultado -->
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                <TextBlock x:Name="ResultText" FontSize="14" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="RetryButton" Style="{StaticResource GhostButton}" Content="Reintentar" Margin="0,0,8,0" Padding="18,9"
                            Visibility="Collapsed" Click="OnRetry" />
                    <Button x:Name="ReleasesButton" Style="{StaticResource GhostButton}" Content="Descargas en GitHub" Margin="0,0,8,0" Padding="18,9"
                            Visibility="Collapsed" Click="OnOpenReleases" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Cerrar" IsDefault="True" Padding="22,9" Click="OnCancel" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
