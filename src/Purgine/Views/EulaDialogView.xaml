<UserControl x:Class="Purgine.Views.EulaDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Purgine.Infrastructure">
    <Grid Background="#B3050608">
        <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" infra:Fx.FadeIn="True"
                Background="#FF1E222C" CornerRadius="{DynamicResource PanelCornerRadius}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                Effect="{DynamicResource ActionBarEffect}">
            <Grid>
                <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource PlayButtonBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" />
                <StackPanel Margin="24,18,24,22">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="7"
                                BorderBrush="Transparent" VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip="Cancelar" />
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Contrato de licencia" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />

                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Left" Width="120" Height="56" CornerRadius="3" Background="{StaticResource CardBrush}" ClipToBounds="True">
                            <Image Source="{Binding Banner}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="16,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,14" />

                    <ItemsControl ItemsSource="{Binding Eulas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#343A48" CornerRadius="{DynamicResource PlayButtonCornerRadius}" Padding="16,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" Padding="10,6"
                                                ToolTip="Abrir el contrato en el navegador">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Leer" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="0,0,6,0" Padding="12,10">
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AcceptCommand}" Margin="6,0,0,0" Padding="12,10">
                            <TextBlock Text="Aceptar licencia y jugar" FontWeight="SemiBold" />
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
