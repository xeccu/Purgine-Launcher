<UserControl x:Class="Purgine.Views.ProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Purgine.Infrastructure">
    <Grid Background="#B3050608">
        <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" infra:Fx.FadeIn="True"
                Background="#FF1E222C" CornerRadius="{DynamicResource PanelCornerRadius}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                Effect="{DynamicResource ActionBarEffect}">
            <Grid>
                <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource PlayButtonBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" />
                <StackPanel Margin="24,18,24,22">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="7"
                                BorderBrush="Transparent" VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip="Cancelar" />
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,18" />

                    <!-- Foto -->
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="96" Height="96">
                            <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="{Binding Initial}" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <Button Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Center" Command="{Binding ChoosePhotoCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Elegir foto…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Nombre -->
                    <TextBlock Text="NOMBRE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6" />
                    <TextBox AutomationProperties.AutomationId="ProfileNameBox" Style="{StaticResource SearchBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" FontSize="15" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Error, Converter={StaticResource NullToVis}}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="Cada perfil tiene sus propias cuentas de Steam, Epic e itch.io, su sesión de la tienda, sus ajustes, etiquetas, tiempo jugado y notas. Los juegos instalados se comparten." />

                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="0,0,6,0" Padding="12,10">
                            <TextBlock Text="Cancelar" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="6,0,0,0" Padding="12,10" IsDefault="True">
                            <TextBlock Text="{Binding SaveText}" FontWeight="SemiBold" />
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
