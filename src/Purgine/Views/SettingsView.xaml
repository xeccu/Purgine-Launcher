<UserControl x:Class="Purgine.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,24" MaxWidth="760" HorizontalAlignment="Left">

            <DockPanel Margin="0,0,0,14">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SavedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Text="Ajustes" FontSize="20" FontWeight="SemiBold" />
            </DockPanel>

            <!-- ===== Cuenta de Epic Games ===== -->
            <Border Style="{StaticResource Panel}" DockPanel.Dock="Top">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="Vincular cuenta" Command="{Binding EpicLoginCommand}"
                                    Visibility="{Binding IsEpicLinked, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="Desvincular" Command="{Binding EpicLogoutCommand}"
                                    Visibility="{Binding IsEpicLinked, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Cuenta de Epic Games" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding EpicAccountText}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Inicias sesión en la página oficial de Epic. Purgine no ve tu contraseña: solo guarda un token de sesión cifrado con Windows (DPAPI). Con la cuenta vinculada, los juegos de Epic se lanzan directamente (como hace Legendary), con tu sesión iniciada y sin abrir Epic Games Launcher; también se leen su tiempo jugado y sus portadas." />
                </StackPanel>
            </Border>

            <!-- ===== Cuenta de Steam ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Content="Iniciar sesión" Command="{Binding LoginCommand}"
                                    Visibility="{Binding IsSteamLoggedIn, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Style="{StaticResource GhostButton}" Content="Cerrar sesión" Command="{Binding LogoutCommand}"
                                    Visibility="{Binding IsSteamLoggedIn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Cuenta de Steam" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AccountText}" Style="{StaticResource MutedText}" FontSize="13" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                               Text="Purgine se conecta directamente a los servidores de Steam (SteamKit2) para leer tus licencias y descargar o actualizar juegos sin abrir el cliente. El cliente oficial solo se usa para jugar. Tu contraseña no se guarda: solo un token de sesión cifrado con Windows (DPAPI), que puedes revocar en la web de Steam → «Dispositivos autorizados»." />
                </StackPanel>
            </Border>

            <!-- ===== Apariencia: 4 estilos (Steam / Epic Games × Moderna / Optimizada) ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Apariencia" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                               Text="Solo cambia el aspecto: biblioteca, logros, cromos, nube, descargas, canje de claves y contratos funcionan igual en los cuatro. Se aplica al instante." />
                    <UniformGrid Columns="2">
                        <UniformGrid.Resources>
                            <!-- Tarjeta seleccionable con miniatura -->
                            <Style TargetType="RadioButton">
                                <Setter Property="GroupName" Value="Appearance" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="12" BorderThickness="2"
                                                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource CardBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </UniformGrid.Resources>

                        <!-- Steam moderna -->
                        <RadioButton IsChecked="{Binding AppearanceSteamModern, Mode=TwoWay}">
                            <StackPanel>
                                <Border Height="84" CornerRadius="6" Background="#0E1014" ClipToBounds="True">
                                    <Grid>
                                        <Border Height="14" VerticalAlignment="Top" Background="#99151820" />
                                        <StackPanel Orientation="Horizontal" Margin="8,22,0,0" VerticalAlignment="Top">
                                            <Border Width="26" Height="38" CornerRadius="4" Background="#2A3550" Margin="0,0,6,0" />
                                            <Border Width="26" Height="38" CornerRadius="4" Background="#2A3550" Margin="0,0,6,0" />
                                            <Border Width="26" Height="38" CornerRadius="4" Background="#2A3550" Margin="0,0,6,0" />
                                        </StackPanel>
                                        <Border Width="46" Height="12" CornerRadius="3" Margin="0,0,8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1A9FFF" Offset="0" />
                                                    <GradientStop Color="#1072BA" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Steam · Moderna" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Style="{StaticResource MutedText}" Text="Cabecera con pestañas, acrílico translúcido, sombras, brillos y animaciones." />
                            </StackPanel>
                        </RadioButton>

                        <!-- Steam optimizada -->
                        <RadioButton IsChecked="{Binding AppearanceSteamLight, Mode=TwoWay}">
                            <StackPanel>
                                <Border Height="84" Background="#0E1014" ClipToBounds="True">
                                    <Grid>
                                        <Border Height="14" VerticalAlignment="Top" Background="#151820" />
                                        <StackPanel Orientation="Horizontal" Margin="8,22,0,0" VerticalAlignment="Top">
                                            <Border Width="26" Height="38" Background="#1C2029" Margin="0,0,6,0" />
                                            <Border Width="26" Height="38" Background="#1C2029" Margin="0,0,6,0" />
                                            <Border Width="26" Height="38" Background="#1C2029" Margin="0,0,6,0" />
                                        </StackPanel>
                                        <Border Width="46" Height="12" Margin="0,0,8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#1A9FFF" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Steam · Optimizada" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Style="{StaticResource MutedText}" Text="Plana: sin animaciones, sombras ni transparencias. El menor consumo." />
                            </StackPanel>
                        </RadioButton>

                        <!-- Epic moderna -->
                        <RadioButton IsChecked="{Binding AppearanceEpicModern, Mode=TwoWay}">
                            <StackPanel>
                                <Border Height="84" CornerRadius="6" Background="#101014" ClipToBounds="True">
                                    <Grid>
                                        <Border Width="34" HorizontalAlignment="Left" Background="#121216" BorderBrush="#2C2C30" BorderThickness="0,0,1,0">
                                            <StackPanel Margin="5,10,5,0">
                                                <Border Height="7" CornerRadius="3" Background="#2A2A2F" Margin="0,0,0,4" />
                                                <Border Height="7" CornerRadius="3" Background="#1C1C20" Margin="0,0,0,4" />
                                                <Border Height="7" CornerRadius="3" Background="#1C1C20" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="42,10,0,0" VerticalAlignment="Top">
                                            <Border Width="24" Height="36" CornerRadius="5" Background="#202024" Margin="0,0,5,0" />
                                            <Border Width="24" Height="36" CornerRadius="5" Background="#202024" Margin="0,0,5,0" />
                                            <Border Width="24" Height="36" CornerRadius="5" Background="#202024" Margin="0,0,5,0" />
                                        </StackPanel>
                                        <Border Width="30" Height="52" CornerRadius="5" Margin="0,10,6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#18181C" BorderBrush="#2C2C30" BorderThickness="1" />
                                        <Border Width="40" Height="10" CornerRadius="5" Margin="42,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Background="#26BBFF" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Epic Games · Moderna" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Style="{StaticResource MutedText}" Text="Barra lateral con inicio rápido, negro neutro, tarjetas redondeadas, filtros a la derecha, sombras y animaciones." />
                            </StackPanel>
                        </RadioButton>

                        <!-- Epic optimizada -->
                        <RadioButton IsChecked="{Binding AppearanceEpicLight, Mode=TwoWay}">
                            <StackPanel>
                                <Border Height="84" CornerRadius="6" Background="#101014" ClipToBounds="True">
                                    <Grid>
                                        <Border Width="34" HorizontalAlignment="Left" Background="#121216" BorderBrush="#2C2C30" BorderThickness="0,0,1,0">
                                            <StackPanel Margin="5,10,5,0">
                                                <Border Height="7" CornerRadius="3" Background="#2A2A2F" Margin="0,0,0,4" />
                                                <Border Height="7" CornerRadius="3" Background="#1C1C20" Margin="0,0,0,4" />
                                                <Border Height="7" CornerRadius="3" Background="#1C1C20" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="42,10,0,0" VerticalAlignment="Top">
                                            <Border Width="24" Height="36" CornerRadius="3" Background="#202024" Margin="0,0,5,0" />
                                            <Border Width="24" Height="36" CornerRadius="3" Background="#202024" Margin="0,0,5,0" />
                                            <Border Width="24" Height="36" CornerRadius="3" Background="#202024" Margin="0,0,5,0" />
                                        </StackPanel>
                                        <Border Width="30" Height="52" CornerRadius="3" Margin="0,10,6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#18181C" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="Epic Games · Optimizada" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Style="{StaticResource MutedText}" Text="La misma distribución de Epic, sin sombras, brillos ni animaciones. Para equipos modestos." />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ===== Al terminar de jugar ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Al cerrar un juego de Steam o Epic" Style="{StaticResource SectionTitle}" />
                    <RadioButton GroupName="Cleanup" IsChecked="{Binding CleanupAlways, Mode=TwoWay}"
                                 Content="Cerrar el launcher (Steam o Epic) siempre (máximo ahorro de RAM y CPU)" />
                    <RadioButton GroupName="Cleanup" IsChecked="{Binding CleanupOnlyOurs, Mode=TwoWay}"
                                 Content="Cerrar el launcher solo si lo abrió Purgine" />
                    <RadioButton GroupName="Cleanup" IsChecked="{Binding CleanupNever, Mode=TwoWay}"
                                 Content="Dejar el launcher abierto" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,6">
                            <TextBlock Text="Espera de sincronización en la nube" />
                            <TextBlock Text="Margen antes de pedir a Steam que se cierre" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="60"
                                TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                Value="{Binding CloudSyncGraceSeconds, Mode=TwoWay}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                   Text="{Binding CloudSyncGraceSeconds, StringFormat={}{0} s}" />

                        <StackPanel Grid.Row="1" Margin="0,6">
                            <TextBlock Text="Tiempo para el cierre ordenado" />
                            <TextBlock Text="Después se fuerzan los procesos que queden" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="5" Maximum="120"
                                TickFrequency="5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                Value="{Binding SteamShutdownTimeoutSeconds, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                   Text="{Binding SteamShutdownTimeoutSeconds, StringFormat={}{0} s}" />

                        <StackPanel Grid.Row="2" Margin="0,6">
                            <TextBlock Text="Espera máxima a que arranque un juego" />
                            <TextBlock Text="Incluye actualizaciones y compilación de shaders" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="30" Maximum="900"
                                TickFrequency="30" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                Value="{Binding GameStartTimeoutSeconds, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                   Text="{Binding GameStartTimeoutSeconds, StringFormat={}{0} s}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Steam mientras juegas ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Steam mientras juegas" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="Se aplica 30 s después de arrancar el juego (cuando ya validó su licencia) y se repite cada 5 minutos. steam.exe mantiene su prioridad: lo necesita el DRM." />
                    <TextBlock Text="Prioridad de CPU de steamwebhelper (interfaz web de Steam)" Margin="0,0,0,4" />
                    <RadioButton GroupName="HelperPriority" IsChecked="{Binding HelperPriorityBelowNormal, Mode=TwoWay}"
                                 Content="Por debajo de lo normal (recomendado)" />
                    <RadioButton GroupName="HelperPriority" IsChecked="{Binding HelperPriorityIdle, Mode=TwoWay}"
                                 Content="Mínima (Idle) — puede volver lenta la interfaz de Steam y el overlay" />
                    <RadioButton GroupName="HelperPriority" IsChecked="{Binding HelperPriorityNormal, Mode=TwoWay}"
                                 Content="Normal (no tocar)" />
                    <CheckBox IsChecked="{Binding TrimSteamMemoryWhilePlaying, Mode=TwoWay}" Margin="0,10,0,4"
                              Content="Liberar la RAM que Steam no está usando (no cierra nada)" />
                    <CheckBox IsChecked="{Binding KillSteamWebHelperWhilePlaying, Mode=TwoWay}"
                              Content="Experimental: cerrar steamwebhelper durante la partida" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="24,2,0,0"
                               Text="Libera más memoria, pero se pierden el overlay (Mayús+Tab), las notificaciones y la ventana de Steam; Steam puede volver a abrirlo solo." />
                </StackPanel>
            </Border>

            <!-- ===== Ventana y bandeja ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Ventana y bandeja del sistema" Style="{StaticResource SectionTitle}" />
                    <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                              Content="La X oculta Purgine en la bandeja, como Steam (para salir: icono de la bandeja → Salir)" />
                    <CheckBox IsChecked="{Binding MinimizeOnLaunch, Mode=TwoWay}"
                              Content="Minimizar la ventana al lanzar un juego" />
                    <CheckBox IsChecked="{Binding ShowNotifications, Mode=TwoWay}"
                              Content="Notificaciones de Windows (nube, descargas, fin de sesión)" />
                    <CheckBox IsChecked="{Binding UseSoftwareRendering, Mode=TwoWay}"
                              Content="Render por software (menos memoria de GPU; requiere reiniciar)" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Text="En la bandeja Purgine libera su memoria (~23 MB). Clic en el icono para volver; clic derecho para salir." />
                </StackPanel>
            </Border>

            <!-- ===== Etiquetas ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Etiquetas" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Padding="12,3,4,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9" Padding="6,4"
                                                BorderThickness="0" Margin="6,0,0,0" ToolTip="Eliminar etiqueta"
                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox Style="{StaticResource SearchBox}" Width="220"
                                 Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddTagCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource GhostButton}" Content="Añadir etiqueta" Margin="8,0,0,0"
                                Command="{Binding AddTagCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Text="Para etiquetar un juego: clic derecho sobre él en la Biblioteca → Etiquetas." />
                </StackPanel>
            </Border>

            <!-- ===== Avanzado ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Avanzado" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Argumentos al arrancar Steam" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding SteamClientArguments, UpdateSourceTrigger=LostFocus}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="Solo se usan si Purgine es quien abre Steam. Por defecto: -silent -nofriendsui -nochatui -minimized -vgui -fulldesktopres 0. Además, durante 90 s tras abrir Steam se oculta su ventana principal si aparece (los diálogos que necesitan tu respuesta no se tocan)." />
                </StackPanel>
            </Border>

            <!-- ===== Datos ===== -->
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Datos y privacidad" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="13" Foreground="{StaticResource TextBrush}"
                               Text="Todo se guarda solo en este equipo. Purgine no guarda contraseñas, tokens ni datos de pago." />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="{Binding DataDir, StringFormat=Carpeta de datos: {0}}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="{Binding SteamPath, StringFormat=Steam: {0}}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0" Text="{Binding Version}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Abrir carpeta de datos" Command="{Binding OpenDataFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Restablecer ajustes" Margin="8,0,0,0" Command="{Binding ResetCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Acerca de ===== -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Command="{Binding OpenWebsiteCommand}" ToolTip="https://xccstudios.es">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="xccstudios.es" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Purgine Launcher" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="13">
                            <Run Text="{Binding VersionText, Mode=OneWay}" />
                            <Run Text=" · Desarrollado por xeccu · XCC Studios" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
