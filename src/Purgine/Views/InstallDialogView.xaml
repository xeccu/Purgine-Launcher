<UserControl x:Class="Purgine.Views.InstallDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Purgine.ViewModels"
             xmlns:infra="clr-namespace:Purgine.Infrastructure">
    <UserControl.Resources>
        <!-- Fila de unidad: azul la seleccionada, gris las demás -->
        <Style x:Key="DriveItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#343A48" CornerRadius="{DynamicResource PlayButtonCornerRadius}" Padding="16,12"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4556" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SteamBlueBrush}" />
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource PlayButtonGlow}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasEnoughSpace}" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Fondo atenuado que cubre la ventana; el clic fuera no cierra (como en Steam) -->
    <Grid Background="#B3050608">
        <Border x:Name="Card" Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" infra:Fx.FadeIn="True"
                Background="#FF1E222C" CornerRadius="{DynamicResource PanelCornerRadius}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                Effect="{DynamicResource ActionBarEffect}">
            <Grid>
                <!-- Línea de acento superior -->
                <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource PlayButtonBrush}"
                        CornerRadius="{DynamicResource PanelCornerRadius}" />
                <StackPanel Margin="24,18,24,22">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Padding="7"
                                BorderBrush="Transparent" VerticalAlignment="Top" Command="{Binding CancelCommand}" ToolTip="Cerrar (Esc)" />
                        <TextBlock Text="Instalar" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,10" />

                    <!-- Juego y tamaño -->
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="120" Height="56" CornerRadius="3" Background="{StaticResource CardBrush}" ClipToBounds="True">
                            <Image Source="{Binding Banner}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" ToolTip="Espacio necesario una vez instalado" />
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="16,0,12,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,12" />

                    <!-- Accesos directos -->
                    <WrapPanel Visibility="{Binding ShowShortcuts, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="Crear acceso directo en el escritorio" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,0,24,6" />
                        <CheckBox Content="Crear acceso directo en el menú Inicio" IsChecked="{Binding CreateStartMenuShortcut}" Margin="0,0,0,6" />
                    </WrapPanel>

                    <!-- Unidad -->
                    <TextBlock Text="INSTALAR EN:" FontSize="12" FontWeight="Bold" Margin="0,18,0,10" />
                    <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DriveItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveOptionViewModel}">
                                <DockPanel ToolTip="{Binding Tooltip}">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Biblioteca con más espacio (la predeterminada)"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Label}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding WarningText, Converter={StaticResource NullToVis}}" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding BrowseCommand}"
                            Visibility="{Binding CanBrowse, Converter={StaticResource BoolToVis}}"
                            ToolTip="Elegir cualquier carpeta (se crea si no existe)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Examinar otra carpeta…" />
                        </StackPanel>
                    </Button>

                    <!-- Acciones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                        <Button Style="{StaticResource SteamPlayButton}" Content="Instalar" Height="40" MinWidth="200" FontSize="14"
                                FontWeight="Normal" Command="{Binding InstallCommand}" IsDefault="True" />
                        <Button Style="{StaticResource GhostButton}" Content="Cancelar" Height="40" MinWidth="200" Margin="14,0,0,0"
                                Background="#343A48" BorderBrush="Transparent" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
