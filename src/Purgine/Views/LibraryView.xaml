<UserControl x:Class="Purgine.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Purgine.ViewModels"
             xmlns:views="clr-namespace:Purgine.Views"
             xmlns:infra="clr-namespace:Purgine.Infrastructure">
    <UserControl.Resources>

        <!-- ===== Fila de la lista lateral: icono 24x24 + nombre + estado ===== -->
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Grid Height="28" Background="Transparent" ToolTip="{Binding Tooltip}" ContextMenu="{StaticResource CardMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Border CornerRadius="3" Background="{StaticResource CardBrush}">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding SmallIcon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,6,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SteamBlueBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource SteamBlueBrush}" ToolTip="{Binding DownloadText}"
                               Visibility="{Binding HasActiveJob, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource SteamBlueBrush}" ToolTip="Actualización disponible"
                               Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="EN CURSO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SteamBlueBrush}"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== Tarjeta de cuadrícula (clic = ficha; botón redondo = jugar/instalar) ===== -->
        <DataTemplate x:Key="GridCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Button Style="{StaticResource GameCardButton}" Margin="8" ToolTip="{Binding Tooltip}"
                    Command="{Binding ShowDetailsCommand}" ContextMenu="{StaticResource CardMenu}"
                    Width="{Binding DataContext.CoverWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel>
                    <Grid Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          infra:Fx.HoverLift="True">
                        <!-- Placeholder: icono del .exe (locales) y nombre. Lleva la sombra del perfil Alto. -->
                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{StaticResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                                Effect="{DynamicResource CoverEffect}">
                            <StackPanel VerticalAlignment="Center" Margin="12"
                                        Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}">
                                <Image Source="{Binding AppIcon}" Width="48" Height="48" Margin="0,0,0,10"
                                       Visibility="{Binding AppIcon, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Portada (atenuada si el juego no está instalado) -->
                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                            <Setter Property="Opacity" Value="0.38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- Insignia «descargar» (no instalado) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="28" Height="28" CornerRadius="14"
                                Background="#CC0E1014" ToolTip="No instalado"
                                Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Insignias -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <Border CornerRadius="4" Background="#CC0E1014" Padding="6,2" Margin="0,0,4,0"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="LOCAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border CornerRadius="4" Background="#CC0E1014" Padding="5,2"
                                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FFD54F" />
                            </Border>
                        </StackPanel>

                        <!-- Progreso de instalación (en cola / descargando) -->
                        <Border VerticalAlignment="Bottom" CornerRadius="{DynamicResource CardBottomCornerRadius}" Background="#E60E1014" Padding="8,6"
                                Visibility="{Binding ShowInstallProgress, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DownloadText}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding DownloadPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminateProgress, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Overlay de hover / en curso con botón de jugar -->
                        <Border CornerRadius="{DynamicResource CardCornerRadius}" Background="{StaticResource OverlayBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Style="{StaticResource RoundPlayButton}" Command="{Binding PrimaryActionCommand}"
                                        Content="{Binding PrimaryActionGlyph}" ToolTip="{Binding PrimaryActionText}" />
                                <TextBlock Text="{Binding OverlayText}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <!-- Actualización pendiente: botón propio (por encima del overlay para recibir el clic) -->
                        <Button Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Margin="8" Padding="8,6" Command="{Binding UpdateCommand}"
                                ToolTip="Descarga solo lo que ha cambiado, sin abrir el cliente de Steam"
                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding UpdateButtonText}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PlaytimeText}" Margin="2,2,2,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowRequiredSize, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="{Binding RequiredSizeText, StringFormat='Tamaño: {0}'}" Margin="2,2,2,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="Espacio necesario para instalarlo"
                               Visibility="{Binding ShowRequiredSize, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ===== Fila de lista compacta ===== -->
        <DataTemplate x:Key="ListRowTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Button Style="{StaticResource RowButton}" ToolTip="{Binding Tooltip}" Margin="0,1"
                    Command="{Binding ShowDetailsCommand}" ContextMenu="{StaticResource CardMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="40" Height="60">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border CornerRadius="4" Background="{StaticResource CardBrush}">
                            <Image Source="{Binding SmallIcon}" Width="24" Height="24" />
                        </Border>
                        <Border CornerRadius="4" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FFD54F"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                   Visibility="{Binding TagsText, Converter={StaticResource NullToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                    Visibility="{Binding ShowInstallProgress, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Style="{StaticResource SlimProgress}" Width="140" Value="{Binding DownloadPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminateProgress, Mode=OneWay}" />
                            <TextBlock Text="{Binding DownloadText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="4" Padding="7,2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PlatformLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </Border>

                    <TextBlock Grid.Column="3" Text="{Binding PlaytimeText}" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowRequiredSize, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Grid.Column="3" Text="{Binding RequiredSizeText, StringFormat='Tamaño: {0}'}" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowRequiredSize, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="4" Style="{StaticResource RoundPlayButton}" Width="34" Height="34" FontSize="13" Margin="8,0,4,0"
                            Command="{Binding PrimaryActionCommand}" Content="{Binding PrimaryActionGlyph}"
                            ToolTip="{Binding PrimaryActionText}" />
                </Grid>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="460" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =================================================================================== -->
        <!-- Lista lateral                                                                       -->
        <!-- =================================================================================== -->
        <Border Grid.Column="0" Background="{DynamicResource ChromeBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
                    <!-- Inicio -->
                    <Button Command="{Binding ShowHomeCommand}" HorizontalContentAlignment="Left" Padding="10,7">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeVisible}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Inicio" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Búsqueda rápida -->
                    <Grid Margin="0,10,0,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Padding="30,6,8,6"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="10,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Buscar" Margin="31,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Filtros y orden -->
                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <Border DockPanel.Dock="Left" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource IconToggle}" GroupName="InstallFilter" FontFamily="Segoe UI Variable Text, Segoe UI"
                                             FontSize="12" IsChecked="{Binding ShowAllGames, Mode=TwoWay}" ToolTip="Todos los juegos de tu cuenta">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Todos" />
                                        <TextBlock Text="{Binding AllCount}" Margin="5,0,0,0" Opacity="0.6" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource IconToggle}" GroupName="InstallFilter" FontFamily="Segoe UI Variable Text, Segoe UI"
                                             FontSize="12" IsChecked="{Binding ShowInstalledOnly, Mode=TwoWay}" ToolTip="Solo los que están en este equipo">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Instalados" />
                                        <TextBlock Text="{Binding InstalledCount}" Margin="5,0,0,0" Opacity="0.6" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Right" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource IconToggle}" GroupName="SortMode" FontFamily="Segoe UI Variable Text, Segoe UI"
                                             FontSize="11" FontWeight="SemiBold" Content="A-Z"
                                             IsChecked="{Binding SortByName, Mode=TwoWay}" ToolTip="Orden alfabético" />
                                <RadioButton Style="{StaticResource IconToggle}" GroupName="SortMode" FontSize="13" Content="&#xE823;"
                                             IsChecked="{Binding SortByPlaytime, Mode=TwoWay}" ToolTip="Por tiempo de juego" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>

                <ListBox x:Name="GameList" Style="{StaticResource SidebarList}" Margin="0,4,0,8"
                         ItemsSource="{Binding GamesView}" ItemTemplate="{StaticResource SidebarItemTemplate}"
                         SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                         SelectionChanged="OnSidebarSelectionChanged" MouseDoubleClick="OnSidebarDoubleClick" />
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" />

        <!-- =================================================================================== -->
        <!-- Inicio: cuadrícula / lista                                                          -->
        <!-- =================================================================================== -->
        <Grid Grid.Column="2" Background="{DynamicResource ContentBrush}" infra:Fx.FadeIn="True"
              Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sin sesión: invitación a sincronizar la biblioteca completa -->
            <Border Grid.Row="0" Margin="24,16,24,0" CornerRadius="10" Padding="18,14"
                    Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding ShowSignInBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                            Command="{Binding SignInCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Iniciar sesión en Steam" />
                        </StackPanel>
                    </Button>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Estás viendo solo los juegos instalados en este equipo" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                   Text="Inicia sesión para sincronizar tu biblioteca completa de Steam e instalar o actualizar juegos sin abrir el cliente. Solo hace falta una vez: la sesión se guarda cifrada en este equipo." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Barra de herramientas -->
            <DockPanel Grid.Row="1" Margin="24,16,24,10" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Todos los juegos" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                                ToolTip="Tamaño de las portadas">
                        <TextBlock Text="&#xE71F;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <Slider Width="110" Margin="8,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Minimum="{Binding MinCoverWidth}" Maximum="{Binding MaxCoverWidth}"
                                Value="{Binding CoverWidth, Mode=TwoWay}" SmallChange="10" LargeChange="20" />
                        <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <Border CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource IconToggle}" GroupName="ViewMode" Content="&#xF0E2;"
                                         IsChecked="{Binding IsGridView, Mode=TwoWay}" ToolTip="Cuadrícula" />
                            <RadioButton Style="{StaticResource IconToggle}" GroupName="ViewMode" Content="&#xE8FD;"
                                         IsChecked="{Binding IsListView, Mode=TwoWay}" ToolTip="Lista compacta" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0" ToolTip="Volver a escanear las bibliotecas" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddLocalGameCommand}"
                            ToolTip="Añadir cualquier .exe: proyectos propios (Godot, Unity…), emuladores o juegos sin tienda">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Añadir ejecutable" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Filtros por etiqueta -->
            <DockPanel Grid.Row="2" Margin="24,0,24,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" VerticalAlignment="Top"
                        Command="{Binding NewTagCommand}" ToolTip="Crear una etiqueta nueva">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Etiqueta" FontSize="12" />
                    </StackPanel>
                </Button>
                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding TagFilters}"
                         SelectedItem="{Binding SelectedTagFilter, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TagFilterViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                <TextBlock Text="{Binding Count}" FontSize="11" Margin="7,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Juegos -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="16,4,16,12" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding GamesView}" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource GridCardTemplate}" />
                            <Setter Property="ItemsPanel" Value="{StaticResource WrapPanelTemplate}" />
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListView}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ListRowTemplate}" />
                                    <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}" />
                                    <Setter Property="Margin" Value="8,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" LineHeight="22"
                       Foreground="{StaticResource MutedBrush}" FontSize="14" IsHitTestVisible="False" />
        </Grid>

        <!-- =================================================================================== -->
        <!-- Ficha del juego                                                                     -->
        <!-- =================================================================================== -->
        <Grid Grid.Column="2" Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" infra:Fx.FadeIn="True">
            <views:GameDetailView DataContext="{Binding Detail}" />
        </Grid>
    </Grid>
</UserControl>
