<UserControl x:Class="Purgine.Views.GameDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Purgine.ViewModels"
             Background="{StaticResource BgBrush}"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <!-- Enlace rápido de la columna derecha -->
        <Style x:Key="LinkRow" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel>
            <!-- ===== Héroe: imagen panorámica + degradado inferior + logo ===== -->
            <Grid x:Name="HeroArea" Height="300" ClipToBounds="True" Background="{StaticResource CardBrush}">
                <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000E1014" Offset="0.35" />
                            <GradientStop Color="#990E1014" Offset="0.75" />
                            <GradientStop Color="#FF151820" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image Source="{Binding Logo}" MaxWidth="440" MaxHeight="150" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,32,28"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Card.Name}" FontSize="34" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,32,28"
                           Visibility="{Binding ShowTitleText, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                    </TextBlock.Effect>
                </TextBlock>
                <Button Style="{StaticResource GhostButton}" Background="#990E1014" BorderBrush="Transparent"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="10,6"
                        Command="{Binding BackCommand}" ToolTip="Volver al inicio de la biblioteca">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Biblioteca" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== Barra de acción ===== -->
            <Border Background="{StaticResource SurfaceBrush}" Padding="32,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource SteamPlayButton}" Command="{Binding Card.PrimaryActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Card.PrimaryActionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Normal" />
                            <TextBlock Text="{Binding Card.PrimaryActionText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel DockPanel.Dock="Left" Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ÚLTIMA SESIÓN" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding Card.LastPlayedText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="32,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TIEMPO DE JUEGO" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding Card.TotalPlaytimeText}" Style="{StaticResource StatValue}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Margin="32,0,0,0" VerticalAlignment="Center" MinWidth="200"
                                Visibility="{Binding Card.ShowInstallProgress, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DESCARGA" Style="{StaticResource StatLabel}" />
                        <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,7,0,4" Value="{Binding Card.DownloadPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding Card.IsIndeterminateProgress, Mode=OneWay}" />
                        <TextBlock Text="{Binding Card.DownloadText}" Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right" x:Name="OptionsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="Más opciones"
                            DataContext="{Binding Card}" ContextMenu="{StaticResource CardMenu}" Click="OnOptionsClick" />
                </DockPanel>
            </Border>

            <!-- ===== Logros + enlaces ===== -->
            <Grid Margin="32,20,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- Logros -->
                    <Border Style="{StaticResource Panel}" Margin="0" Visibility="{Binding ShowAchievements, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" Content="Ver todos"
                                        FontSize="12" Command="{Binding OpenAchievementsCommand}" />
                                <TextBlock Text="LOGROS" Style="{StaticResource StatLabel}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding AchievementsText}" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap" />
                            <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Margin="0,10,0,0" Maximum="100"
                                         Value="{Binding AchievementsPercent, Mode=OneWay}" Foreground="{StaticResource SteamBlueBrush}"
                                         Visibility="{Binding HasAchievementProgress, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,10,0,0" IsIndeterminate="True"
                                         Visibility="{Binding IsLoadingAchievements, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding TopAchievements}" Margin="0,14,0,0" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AchievementItemViewModel}">
                                        <Border Width="56" Height="56" Margin="0,0,8,8" CornerRadius="4" Background="{StaticResource CardBrush}"
                                                ToolTip="{Binding Tooltip}">
                                            <Image Source="{Binding Icon}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Locales: información del ejecutable -->
                    <Border Style="{StaticResource Panel}" Margin="0" Visibility="{Binding Card.IsLocal, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="EJECUTABLE LOCAL" Style="{StaticResource StatLabel}" FontSize="12" />
                            <TextBlock Text="{Binding Card.Entry.ExecutablePath}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Enlaces rápidos -->
                <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="ENLACES" Style="{StaticResource StatLabel}" FontSize="12" Margin="8,0,0,8" />
                        <Button Style="{StaticResource LinkRow}" Command="{Binding OpenStoreCommand}"
                                Visibility="{Binding Card.IsSteam, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Página de la tienda" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkRow}" Command="{Binding OpenCommunityCommand}"
                                Visibility="{Binding Card.IsSteam, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Centro de la comunidad" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkRow}" Command="{Binding OpenDiscussionsCommand}"
                                Visibility="{Binding Card.IsSteam, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Discusiones" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkRow}" Command="{Binding OpenGuidesCommand}"
                                Visibility="{Binding Card.IsSteam, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE82D;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Guías" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkRow}" Command="{Binding OpenSupportCommand}"
                                Visibility="{Binding Card.IsSteam, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Soporte" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource LinkRow}" Command="{Binding Card.OpenFolderCommand}"
                                Visibility="{Binding Card.IsNotInstalled, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Carpeta del juego" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
