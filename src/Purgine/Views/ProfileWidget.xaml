<UserControl x:Class="Purgine.Views.ProfileWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Foto redonda (o la inicial si no hay foto) -->
        <DataTemplate x:Key="AvatarSmall">
            <Grid Width="28" Height="28">
                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AvatarLarge">
            <Grid Width="44" Height="44">
                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- Fila clicable del menú -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Perfil activo: foto + nombre; al pulsar, el menú de perfiles -->
        <ToggleButton x:Name="Toggle" Cursor="Hand"
                      ToolTip="Perfil activo: cambiar de perfil, editarlo o añadir otro">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="6,4,10,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <DockPanel>
                <ContentPresenter DockPanel.Dock="Left" Content="{Binding Active}" ContentTemplate="{StaticResource AvatarSmall}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Active.Name}" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
            </DockPanel>
        </ToggleButton>

        <Popup PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" VerticalOffset="6">
            <Border Style="{StaticResource DropdownPanel}" Width="270" ButtonBase.Click="OnMenuClick">
                <StackPanel>
                    <!-- Activo -->
                    <DockPanel Margin="4,2,4,10">
                        <ContentPresenter DockPanel.Dock="Left" Content="{Binding Active}" ContentTemplate="{StaticResource AvatarLarge}" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Active.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Perfil activo" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <Button Style="{StaticResource MenuRow}" Command="{Binding EditCommand}" CommandParameter="{Binding Active}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Editar nombre y foto" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8" />
                    <TextBlock Text="CAMBIAR A" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Others}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MenuRow}" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                            ToolTip="Borrar este perfil" Padding="0" Width="32"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource MenuRow}"
                                            Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Cambiar a este perfil (Purgine se reinicia con sus datos)">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AvatarSmall}" />
                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8" />
                    <Button Style="{StaticResource MenuRow}" Command="{Binding AddCommand}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Width="22" VerticalAlignment="Center" />
                            <TextBlock Text="Añadir perfil" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
