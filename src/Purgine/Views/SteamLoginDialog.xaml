<Window x:Class="Purgine.Views.SteamLoginDialog" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Width="420" Title="Iniciar sesión en Steam">
    <StackPanel Margin="24,20">
        <TextBlock Text="Cuenta de Steam" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                   Text="Conexión directa con los servidores de Steam. La contraseña no se guarda: solo un token de sesión cifrado en este equipo." />

        <TextBlock Text="Nombre de cuenta" Margin="0,0,0,4" />
        <TextBox x:Name="UserBox" Style="{StaticResource SearchBox}" />

        <TextBlock Text="Contraseña" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordBox" Padding="10,7" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource TextBrush}" />

        <Border x:Name="StatusPanel" Margin="0,16,0,0" CornerRadius="6" Padding="12,10" Background="{StaticResource AccentSoftBrush}"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <ProgressBar x:Name="Busy" Style="{StaticResource SlimProgress}" Margin="0,8,0,0" IsIndeterminate="True" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Cancelar" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Content="Iniciar sesión" IsDefault="True" Click="OnLogin" />
        </StackPanel>
    </StackPanel>
</Window>
