<Window x:Class="Purgine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Purgine.Views"
        xmlns:infra="clr-namespace:Purgine.Infrastructure"
        Title="Purgine"
        Icon="/Assets/app.ico"
        Width="1220" Height="780" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Estilo Epic: barra lateral (navegación + inicio rápido) ===== -->
        <Border Grid.Column="0" Width="224" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsEpicSkin, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="12,18,12,12">
                <!-- Perfil activo (foto redonda + nombre): un clic para cambiar de perfil -->
                <views:ProfileWidget DockPanel.Dock="Top" DataContext="{Binding Profiles}" Margin="0,0,0,20" HorizontalAlignment="Stretch" />

                <!-- Descargas abajo, como el icono de descargas de la tienda -->
                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource SideNavItem}" GroupName="SideNav"
                             IsChecked="{Binding IsDownloadsView, Mode=TwoWay}" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border DockPanel.Dock="Right" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}"
                                Visibility="{Binding Downloads.HasBadge, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Downloads.BadgeCount}" FontSize="11" FontWeight="Bold" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Descargas" VerticalAlignment="Center" />
                    </DockPanel>
                </RadioButton>

                <StackPanel>
                    <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" IsChecked="{Binding IsStoreView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Tienda" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" IsChecked="{Binding IsLibraryView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Biblioteca" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" IsChecked="{Binding IsRedeemView, Mode=TwoWay}"
                                 ToolTip="Canjear una clave de producto de Steam o de Epic Games">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Canjear" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SideNavItem}" GroupName="SideNav" IsChecked="{Binding IsSettingsView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Inicio rápido: los últimos juegos listos para jugar -->
                    <TextBlock Text="INICIO RÁPIDO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="10,26,0,8" />
                    <ItemsControl ItemsSource="{Binding QuickLaunchGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding PrimaryActionCommand}" ToolTip="{Binding Name}" Cursor="Hand" Margin="0,0,0,4"
                                        Foreground="{StaticResource TextBrush}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="8,6">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" ClipToBounds="True"
                                                            Background="{StaticResource CardBrush}" Margin="0,0,10,0">
                                                        <Image Source="{Binding SmallIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="Hint" Text="&#x25B6; Iniciar" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   Visibility="Collapsed" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

    <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Cabecera + navegación ===== -->
        <Border Grid.Row="0" Padding="24,12" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsEpicSkin, Converter={StaticResource InverseBoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo-mark-light.png" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Purgine" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Perfil activo (foto + nombre) con su menú de perfiles -->
                <views:ProfileWidget DockPanel.Dock="Right" DataContext="{Binding Profiles}" VerticalAlignment="Center" Margin="12,0,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0">
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsLibraryView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Biblioteca" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsStoreView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Tienda" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsRedeemView, Mode=TwoWay}"
                                 ToolTip="Canjear una clave de producto de Steam o de Epic Games">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Canjear" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsDownloadsView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Descargas" />
                            <Border CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}"
                                    Visibility="{Binding Downloads.HasBadge, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Downloads.BadgeCount}" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="{Binding IsSettingsView, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Ajustes" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Banner de sincronización en la nube ===== -->
        <Border Grid.Row="1" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,1" Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <DockPanel Margin="24,12">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerText}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BannerDetail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <ProgressBar Style="{StaticResource SlimProgress}" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True"
                             Background="Transparent" />
            </Grid>
        </Border>

        <!-- ===== Contenido ===== -->
        <Grid Grid.Row="2">
            <views:LibraryView Visibility="{Binding IsLibraryView, Converter={StaticResource BoolToVis}}" infra:Fx.FadeIn="True" />
            <Grid Visibility="{Binding IsStoreBrowserVisible, Converter={StaticResource BoolToVis}}" infra:Fx.FadeIn="True">
                <views:StoreView DataContext="{Binding Store}" />
            </Grid>
            <Grid Visibility="{Binding IsDownloadsView, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ContentBrush}" infra:Fx.FadeIn="True">
                <views:DownloadsView DataContext="{Binding Downloads}" />
            </Grid>
            <Grid Visibility="{Binding IsSettingsView, Converter={StaticResource BoolToVis}}" Background="{DynamicResource ContentBrush}" infra:Fx.FadeIn="True">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Grid>
        </Grid>

        <!-- ===== Barra de estado ===== -->
        <Border Grid.Row="3" Padding="20,8" Background="{DynamicResource ChromeBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,4" Margin="8,0,0,0"
                        Command="{Binding ForceCloseCommand}" BorderBrush="{StaticResource DangerBrush}"
                        Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}"
                        ToolTip="Termina el juego y todos sus procesos al instante (si se ha colgado)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Forzar cierre" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Content="Dejar de vigilar" Style="{StaticResource GhostButton}" Padding="12,4"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}"
                        ToolTip="Deja de seguir la sesión. El juego y Steam siguen abiertos." />
                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>

        <!-- ===== Diálogo de instalar (superposición, sin ventanas externas) ===== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding InstallDialog, Converter={StaticResource NullToVis}}">
            <views:InstallDialogView DataContext="{Binding InstallDialog}" />
        </Grid>

        <!-- ===== Nueva versión disponible (superposición) ===== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="104"
              Visibility="{Binding Updates.IsOpen, Converter={StaticResource BoolToVis}}">
            <views:UpdateDialogView DataContext="{Binding Updates}" />
        </Grid>

        <!-- ===== Crear / editar perfil (superposición) ===== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="103"
              Visibility="{Binding Profiles.Editor, Converter={StaticResource NullToVis}}">
            <views:ProfileEditorView DataContext="{Binding Profiles.Editor}" />
        </Grid>

        <!-- ===== Selector de versiones de itch.io (superposición) ===== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding ItchBuildDialog, Converter={StaticResource NullToVis}}">
            <views:ItchBuildDialogView DataContext="{Binding ItchBuildDialog}" />
        </Grid>

        <!-- ===== Contrato de licencia de Steam (superposición) ===== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="102"
              Visibility="{Binding EulaDialog, Converter={StaticResource NullToVis}}">
            <views:EulaDialogView DataContext="{Binding EulaDialog}" />
        </Grid>

        <!-- ===== Conflicto de partidas en la nube (superposición) ===== -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="101"
              Visibility="{Binding CloudConflict, Converter={StaticResource NullToVis}}">
            <views:CloudConflictView DataContext="{Binding CloudConflict}" />
        </Grid>

    </Grid>
</Window>
