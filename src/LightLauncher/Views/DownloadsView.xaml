<UserControl x:Class="LightLauncher.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LightLauncher.ViewModels">
    <Grid Margin="24,16,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabecera ===== -->
        <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding PauseAllCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Pausar todo" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ResumeAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Reanudar todo" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Descargas" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ===== En curso / en cola ===== -->
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                            <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="54" Height="80" CornerRadius="5" Background="{StaticResource CardBrush}">
                                        <Border CornerRadius="5" Visibility="{Binding Cover, Converter={StaticResource NullToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Margin="0,10,0,8"
                                                     Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding KindText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,10,0" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding PhaseText}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE769;" Margin="0,0,6,0" ToolTip="Pausar"
                                                Command="{Binding PauseCommand}"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Margin="0,0,6,0" ToolTip="Reanudar"
                                                Command="{Binding ResumeCommand}"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource GhostButton}" Content="Cancelar" Command="{Binding CancelCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Completadas en esta sesión ===== -->
                <DockPanel Margin="0,10,0,8" Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Limpiar" Padding="10,4"
                            Command="{Binding ClearCompletedCommand}" />
                    <TextBlock Text="Terminadas" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Completed}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CompletedDownloadViewModel}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="54" CornerRadius="4" Background="{StaticResource CardBrush}">
                                    <Border CornerRadius="4" Visibility="{Binding Cover, Converter={StaticResource NullToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Jugar" VerticalAlignment="Center"
                                        Command="{Binding PlayCommand}"
                                        Visibility="{Binding Completed, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Vacío ===== -->
                <StackPanel Margin="0,80,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="No hay descargas" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Instala un juego desde la Biblioteca o la Tienda y verás aquí su progreso en tiempo real."
                               Style="{StaticResource MutedText}" FontSize="13" TextAlignment="Center" MaxWidth="360" />
                </StackPanel>

                <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0"
                           Text="Descargas directas desde la CDN de Steam (SteamKit2), sin abrir el cliente: progreso y velocidad son los bytes reales recibidos. Al reanudar o actualizar solo se descarga lo que falta o ha cambiado. Al terminar, el juego se registra en Steam (con Steam cerrado) para poder jugarlo." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
