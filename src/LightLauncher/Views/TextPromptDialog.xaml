<Window x:Class="LightLauncher.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Width="400" Title="LightLauncher">
    <StackPanel Margin="22,20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="InputBox" Style="{StaticResource SearchBox}" MaxLength="40" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Aceptar" IsDefault="True" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>
