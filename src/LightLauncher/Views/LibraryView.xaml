<UserControl x:Class="LightLauncher.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LightLauncher.ViewModels">
    <UserControl.Resources>

        <!-- Menú contextual común a cuadrícula y lista -->
        <ContextMenu x:Key="CardMenu" x:Shared="False">
            <MenuItem Header="Jugar" Command="{Binding PlayCommand}" FontWeight="SemiBold"
                      Visibility="{Binding IsNotInstalled, Converter={StaticResource InverseBoolToVis}}" />
            <MenuItem Header="Instalar" Command="{Binding InstallCommand}" FontWeight="SemiBold"
                      Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Instalar con el diálogo de Steam" Command="{Binding InstallWithSteamCommand}"
                      Visibility="{Binding ShowSteamInstallOption, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Cancelar instalación" Command="{Binding CancelInstallCommand}"
                      Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}" FontWeight="SemiBold"
                      Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}" />
            <Separator />
            <MenuItem Header="Etiquetas" ItemsSource="{Binding TagToggles}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Header" Value="{Binding Name}" />
                        <Setter Property="IsCheckable" Value="True" />
                        <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=TwoWay}" />
                        <Setter Property="StaysOpenOnClick" Value="True" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="Nueva etiqueta…" Command="{Binding NewTagCommand}" />
            <Separator />
            <MenuItem Header="Abrir carpeta del juego" Command="{Binding OpenFolderCommand}" />
            <MenuItem Header="Ver en la tienda" Command="{Binding ViewInStoreCommand}"
                      Visibility="{Binding IsSteam, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Desinstalar…" Command="{Binding UninstallCommand}"
                      Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Editar…" Command="{Binding EditCommand}"
                      Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Quitar de la biblioteca" Command="{Binding RemoveCommand}"
                      Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}" />
        </ContextMenu>

        <!-- ===== Tarjeta de cuadrícula ===== -->
        <DataTemplate x:Key="GridCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Button Style="{StaticResource GameCardButton}" Margin="8" ToolTip="{Binding Tooltip}"
                    Command="{Binding PlayCommand}" ContextMenu="{StaticResource CardMenu}"
                    Width="{Binding DataContext.CoverWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel>
                    <Grid Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <!-- Placeholder: icono del .exe (locales) y nombre -->
                        <Border CornerRadius="8" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" Margin="12"
                                        Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}">
                                <Image Source="{Binding AppIcon}" Width="48" Height="48" Margin="0,0,0,10"
                                       Visibility="{Binding AppIcon, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Portada (atenuada si el juego no está instalado) -->
                        <Border CornerRadius="8" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                            <Setter Property="Opacity" Value="0.38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- Insignia «descargar» (no instalado) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Width="28" Height="28" CornerRadius="14"
                                Background="#CC0E1014" ToolTip="No instalado: haz clic para instalarlo"
                                Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Insignias -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                            <Border CornerRadius="4" Background="#CC0E1014" Padding="6,2" Margin="0,0,4,0"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="LOCAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <Border CornerRadius="4" Background="#CC0E1014" Padding="5,2"
                                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FFD54F" />
                            </Border>
                        </StackPanel>

                        <!-- Progreso de instalación (en cola / descargando) -->
                        <Border VerticalAlignment="Bottom" CornerRadius="0,0,8,8" Background="#E60E1014" Padding="8,6"
                                Visibility="{Binding ShowInstallProgress, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DownloadText}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding DownloadPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsIndeterminateProgress, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Overlay de hover / en curso -->
                        <Border CornerRadius="8" Background="{StaticResource OverlayBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentBrush}">
                                    <Grid>
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"
                                                   Visibility="{Binding IsNotInstalled, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding OverlayText}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <!-- Actualización pendiente: botón propio (por encima del overlay para recibir el clic) -->
                        <Button Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                Margin="8" Padding="8,6" Command="{Binding UpdateCommand}"
                                ToolTip="Despierta Steam en segundo plano, actualiza y lo cierra al terminar"
                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding UpdateButtonText}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PlaytimeText}" Margin="2,2,2,0" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ===== Fila de lista compacta ===== -->
        <DataTemplate x:Key="ListRowTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Button Style="{StaticResource RowButton}" ToolTip="{Binding Tooltip}" Margin="0,1"
                    Command="{Binding PlayCommand}" ContextMenu="{StaticResource CardMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Miniatura (atenuada si no está instalado) -->
                    <Grid Width="40" Height="60">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotInstalled}" Value="True">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border CornerRadius="4" Background="{StaticResource CardBrush}">
                            <Image Source="{Binding AppIcon}" Width="24" Height="24" />
                        </Border>
                        <Border CornerRadius="4" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FFD54F"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                   Visibility="{Binding TagsText, Converter={StaticResource NullToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                    Visibility="{Binding ShowInstallProgress, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Style="{StaticResource SlimProgress}" Width="140" Value="{Binding DownloadPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminateProgress, Mode=OneWay}" />
                            <TextBlock Text="{Binding DownloadText}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Style="{StaticResource PrimaryButton}" Padding="10,4" Margin="0,0,10,0" Command="{Binding UpdateCommand}"
                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding UpdateButtonText}" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Border CornerRadius="4" Padding="7,2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlatformLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding PlaytimeText}" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="4" Width="34" Height="34" CornerRadius="17" Margin="8,0,4,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"
                                       Visibility="{Binding IsNotInstalled, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StackPanelTemplate">
            <StackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Barra de herramientas ===== -->
        <DockPanel Grid.Row="0" Margin="24,16,24,10" LastChildFill="False">
            <!-- Búsqueda -->
            <Grid DockPanel.Dock="Left" Width="280">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Padding="32,7,10,7"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Margin="11,0,0,0" FontSize="13"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Buscar en tu biblioteca…" Margin="33,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Filtro rápido: Todos | Instalados -->
            <Border DockPanel.Dock="Left" Margin="12,0,0,0" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource IconToggle}" GroupName="InstallFilter" FontFamily="Segoe UI Variable Text, Segoe UI"
                                 FontSize="12" IsChecked="{Binding ShowAllGames, Mode=TwoWay}" ToolTip="Todos los juegos de tu cuenta">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Todos" />
                            <TextBlock Text="{Binding AllCount}" Margin="6,0,0,0" Opacity="0.6" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource IconToggle}" GroupName="InstallFilter" FontFamily="Segoe UI Variable Text, Segoe UI"
                                 FontSize="12" IsChecked="{Binding ShowInstalledOnly, Mode=TwoWay}" ToolTip="Solo los que están en este equipo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Instalados" />
                            <TextBlock Text="{Binding InstalledCount}" Margin="6,0,0,0" Opacity="0.6" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Tamaño de portada (solo cuadrícula) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                            ToolTip="Tamaño de las portadas">
                    <TextBlock Text="&#xE71F;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <Slider Width="110" Margin="8,0" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Minimum="{Binding MinCoverWidth}" Maximum="{Binding MaxCoverWidth}"
                            Value="{Binding CoverWidth, Mode=TwoWay}" SmallChange="10" LargeChange="20" />
                    <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <Border CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource IconToggle}" GroupName="ViewMode" Content="&#xF0E2;"
                                     IsChecked="{Binding IsGridView, Mode=TwoWay}" ToolTip="Cuadrícula" />
                        <RadioButton Style="{StaticResource IconToggle}" GroupName="ViewMode" Content="&#xE8FD;"
                                     IsChecked="{Binding IsListView, Mode=TwoWay}" ToolTip="Lista compacta" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0" ToolTip="Volver a escanear las bibliotecas" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddLocalGameCommand}"
                        ToolTip="Añadir cualquier .exe: proyectos propios (Godot, Unity…), emuladores o juegos sin tienda">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Añadir ejecutable" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ===== Filtros por etiqueta ===== -->
        <DockPanel Grid.Row="1" Margin="24,0,24,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" VerticalAlignment="Top"
                    Command="{Binding NewTagCommand}" ToolTip="Crear una etiqueta nueva">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Etiqueta" FontSize="12" />
                </StackPanel>
            </Button>
            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding TagFilters}"
                     SelectedItem="{Binding SelectedTagFilter, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TagFilterViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontSize="12" />
                            <TextBlock Text="{Binding Count}" FontSize="11" Margin="7,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Juegos ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,4,16,12" PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding GamesView}" Focusable="False">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemTemplate" Value="{StaticResource GridCardTemplate}" />
                        <Setter Property="ItemsPanel" Value="{StaticResource WrapPanelTemplate}" />
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListView}" Value="True">
                                <Setter Property="ItemTemplate" Value="{StaticResource ListRowTemplate}" />
                                <Setter Property="ItemsPanel" Value="{StaticResource StackPanelTemplate}" />
                                <Setter Property="Margin" Value="8,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" LineHeight="22"
                   Foreground="{StaticResource MutedBrush}" FontSize="14" IsHitTestVisible="False" />
    </Grid>
</UserControl>
