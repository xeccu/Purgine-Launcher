<Window x:Class="LightLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LightLauncher.ViewModels"
        Title="LightLauncher"
        Width="1180" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Cabecera ===== -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="LightLauncher" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" ToolTip="Volver a escanear las bibliotecas locales" />
                    <Button Content="Datos" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" ToolTip="Abrir la carpeta de ajustes, estadísticas y log" />
                </StackPanel>

                <Grid Width="300" Margin="24,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Buscar juego…" Margin="12,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Grid de juegos ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12" PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding GamesView}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameCardViewModel}">
                        <Button x:Name="Card" Style="{StaticResource GameCardButton}" Margin="8" ToolTip="{Binding Tooltip}"
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <StackPanel Width="160">
                                <Grid Height="240">
                                    <!-- Placeholder: nombre sobre fondo neutro -->
                                    <Border CornerRadius="8" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                                   VerticalAlignment="Center" Margin="14" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>

                                    <!-- Portada de la caché local de Steam -->
                                    <Border CornerRadius="8" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <!-- Overlay de hover / en curso -->
                                    <Border CornerRadius="8" Background="{StaticResource OverlayBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentBrush}">
                                                <Path Data="M 0,0 L 16,10 L 0,20 Z" Fill="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Border>
                                            <TextBlock Text="{Binding OverlayText}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Name}" Margin="2,8,2,0" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PlaytimeText}" Margin="2,2,2,0" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Estado vacío / escaneando -->
        <TextBlock Grid.Row="1" Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                   Foreground="{StaticResource MutedBrush}" FontSize="14" IsHitTestVisible="False" />

        <!-- ===== Barra de estado ===== -->
        <Border Grid.Row="2" Padding="20,8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dejar de vigilar" Style="{StaticResource GhostButton}" Padding="12,4"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}"
                        ToolTip="Deja de seguir la sesión. El juego y Steam siguen abiertos." />
                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSessionActive}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
