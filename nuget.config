<?xml version="1.0" encoding="utf-8"?>
<!-- Origen de paquetes del repositorio: no depende de la configuración global de NuGet del equipo. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
